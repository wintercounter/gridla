{
  "name": "gridla-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "website",
    "tests/package/consumers/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter gridla build",
    "build:examples": "bun run --filter './examples/*' build",
    "build:website": "bun run --filter gridla-website build",
    "dev:gallery": "bun run --filter gridla-gallery dev",
    "dev:studio": "bun run --filter gridla-studio dev",
    "dev:website": "bun run --filter gridla-website dev",
    "test": "bun test packages tests/compatibility tests/invariants",
    "test:watch": "bun test --watch packages tests/compatibility tests/invariants",
    "test:coverage": "bun test --coverage packages tests/compatibility tests/invariants",
    "test:package": "bun run scripts/verify-package.ts",
    "test:e2e": "playwright test",
    "bench": "bun run benchmarks/run.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@happy-dom/global-registrator": "20.13.2",
    "@playwright/test": "1.62.1",
    "@rsbuild/core": "2.2.2",
    "@rsbuild/plugin-react": "2.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "fast-check": "4.9.0",
    "happy-dom": "20.13.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=20.19"
  },
  "packageManager": "bun@1.3.14"
}

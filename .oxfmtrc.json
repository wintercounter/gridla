{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": [
    "**/dist/**",
    "**/doc_build/**",
    "**/node_modules/**",
    "**/.rspress/**",
    "CHANGELOG.md",
    "**/CHANGELOG.md",
    "website/docs/api/**"
  ]
}

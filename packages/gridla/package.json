{
  "name": "gridla",
  "version": "0.1.0",
  "description": "Pixel-based grid and nested-layout engine with move, resize, place, and transfer solving. Framework-neutral core with an optional React adapter.",
  "keywords": [
    "dashboard",
    "drag",
    "grid",
    "layout",
    "nested-layout",
    "page-builder",
    "react",
    "resize",
    "responsive",
    "typescript"
  ],
  "homepage": "https://wintercounter.github.io/gridla/",
  "bugs": {
    "url": "https://github.com/wintercounter/gridla/issues"
  },
  "license": "MIT",
  "author": "Viktor Vincze <wintercounter@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintercounter/gridla.git",
    "directory": "packages/gridla"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "default": "./dist/interaction.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "bun test src"
  },
  "devDependencies": {
    "@angular/common": "^20",
    "@angular/compiler": "^20",
    "@angular/compiler-cli": "^20",
    "@angular/core": "^20",
    "@angular/platform-browser": "^20",
    "@builder.io/qwik": "^1.14",
    "@microsoft/api-extractor": "7.59.0",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@rsbuild/plugin-svelte": "^2.0.1",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rslib/core": "0.23.2",
    "@sveltejs/package": "^2.5.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "happy-dom": "20.13.2",
    "ng-packagr": "^20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "^1.9",
    "svelte": "^5",
    "svelte-check": "^4.7.6",
    "vue": "^3.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
